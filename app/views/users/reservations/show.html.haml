.container.mt-4
  .fs-2 予約詳細

  .card.mt-4.mb-4
    .card-body
      %h5.card-title.mb-1= @reservation.room_type.accommodation.name

      %h6.text-muted.mb-3= @reservation.room_type.name

      %p
        %strong= Reservation.human_attribute_name(:check_in_date)
        = l(@reservation.check_in_date)

      %p
        %strong チェックアウト日
        = l(@reservation.check_in_date + @reservation.night_count.days)

      %p
        %strong= Reservation.human_attribute_name(:night_count)
        = "#{@reservation.night_count}泊"

      %p
        %strong= Reservation.human_attribute_name(:adult_count)
        = "#{@reservation.adult_count}名"

      %p
        %strong= Reservation.human_attribute_name(:child_count)
        = "#{@reservation.child_count}名"

      %p
        %strong= Reservation.human_attribute_name(:total_amount)
        = number_to_currency(@reservation.total_amount)

      %p
        %strong= Reservation.human_attribute_name(:status)
        = @reservation.status_text

  - if @reservation.cancellable?
    = button_to '予約をキャンセル', users_reservation_path(@reservation), method: :patch, class: 'btn btn-outline-danger w-100'
  - if @reservation.reviewable?
    = link_to 'レビューする', new_users_reservation_review_path(@reservation), class: 'btn btn-outline-success w-100 mt-2'
  - elsif @reservation.reviews.present?
    %span.text-muted レビュー済み
