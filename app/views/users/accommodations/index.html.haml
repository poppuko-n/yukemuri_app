.container.mt-4
  .fs-2 宿泊施設一覧

  .card.mt-2
    .card-body
      = simple_form_for(@form, url: accommodations_path, method: :get) do |f|
        .row.align-items-center
          .col-3
            = f.input :category, collection: Accommodation.category.options
          .col-3
            = f.input :prefecture, collection: Prefecture::LIST
          .row
            .col-3
              = f.submit '検索', class: 'btn btn-primary'

  .row.g-4.mt-2
    - @accommodations.each do |accommodation|
      .col-12.col-sm-6.col-md-4.col-lg-3
        .card
          .ratio.ratio-4x3
            = image_tag accommodation.image
          .card-body
            .d-flex.justify-content-between.align-items-center
              .fs-4= accommodation.name
              .fs-6= published_badge(accommodation)
            .d-flex.justify-content-between.align-items-center
              .fs-6= accommodation.category_text
              .fs-6= accommodation.prefecture_name
            = link_to '詳細', users_root_path, class: 'btn btn-outline-primary btn-sm w-100 mt-2'
