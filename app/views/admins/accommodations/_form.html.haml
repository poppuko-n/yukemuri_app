= simple_form_for [:admins, accommodation], html: { multipart: true, data: { turbo: false } }  do |f|
  = f.input :name, required: true
  = f.input :prefecture, required: true
  = f.input :address, required: true
  = f.input :phone_number, required: true
  = f.input :category, required: true
  = f.input :image, as: :file
  = f.input :description, required: true, input_html: { row: 5 }
  = f.input :published, required: true
  = f.button :submit, class: 'btn btn-outline-primary'