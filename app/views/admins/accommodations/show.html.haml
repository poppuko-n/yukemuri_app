.container.mt-4
  .fs-2 宿泊施設詳細
  .row.justify-content-center
    .col-md-6
      .ratio.ratio-4x3
        = image_tag @accommodation.image
    .col-md-6
      .card
        .card-body
          %p.fs-3
            名称：
            = @accommodation.name
          %p.fs-4
            都道府県：
            = @accommodation.prefecture_name
          %p.fs-4
            カテゴリ：
            = @accommodation.category
          %p.fs-4
            住所：
            = @accommodation.address
          %p.fs-4
            電話番号：
            = @accommodation.phone_number
          %p.fs-4
            説明：
            = @accommodation.description
          %p.fs-4
            公開：
            = @accommodation.published
      = link_to '編集', edit_admins_accommodation_path(@accommodation), class: 'btn btn-primary w-100 mt-2'
      = button_to '削除', admins_accommodation_path(@accommodation), class: 'btn btn-danger w-100 mt-2'

