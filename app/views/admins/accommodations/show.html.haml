.container.mt-4
  .fs-2 宿泊施設詳細

  .row.justify-content-center
    .col-md-6
      .ratio.ratio-4x3
        = image_tag @accommodation.image

    .col-md-6
      .card
        .card-body
          %dl
            %dt 名称
            %dd= @accommodation.name

            %dt 都道府県
            %dd= @accommodation.prefecture_name

            %dt カテゴリ
            %dd= @accommodation.category_text

            %dt 住所
            %dd= @accommodation.address

            %dt 電話番号
            %dd= @accommodation.phone_number

            %dt 説明
            %dd= @accommodation.description

          = published_badge(@accommodation)

      = link_to '編集', edit_admins_accommodation_path(@accommodation), class: 'btn btn-primary w-100 mt-2'
      = button_to '削除', admins_accommodation_path(@accommodation), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger w-100 mt-2'
