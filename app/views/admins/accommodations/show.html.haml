.container.mt-4
  .fs-2 宿泊施設詳細

  .row.justify-content-center.mt-4
    .col-md-6
      .ratio.ratio-4x3
        = image_tag @accommodation.image

    .col-md-6
      .card
        .card-body
          %dl
            %dt= Accommodation.human_attribute_name(:name)
            %dd= @accommodation.name
            %dt= Accommodation.human_attribute_name(:prefecture)
            %dd= @accommodation.prefecture_name
            %dt= Accommodation.human_attribute_name(:category)
            %dd= @accommodation.category_text
            %dt= Accommodation.human_attribute_name(:address)
            %dd= @accommodation.address
            %dt= Accommodation.human_attribute_name(:phone_number)
            %dd= @accommodation.phone_number
            %dt= Accommodation.human_attribute_name(:description)
            %dd= @accommodation.description
          = published_badge(@accommodation)

      = link_to '編集', edit_admins_accommodation_path(@accommodation), class: 'btn btn-outline-success w-100 mt-2'
      = button_to '削除', admins_accommodation_path(@accommodation), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-outline-danger w-100 mt-2'

    .d-flex.justify-content-between.align-items-center.mt-4
      .fs-2 部屋タイプ一覧
      = link_to '部屋タイプ作成', new_admins_accommodation_room_type_path(@accommodation), class: 'btn btn btn-outline-primary'

    - if @accommodation.room_types.any?
      %table.table.table-stripedi.mt-4.table-hover
        %thead
          %tr
            %th= RoomType.human_attribute_name(:name)
            %th= RoomType.human_attribute_name(:capacity)
            %th= RoomType.human_attribute_name(:base_price)
        %tbody
          - @accommodation.room_types.each do |room_type|
            %tr
              %td= link_to room_type.name, admins_root_path(@accommodation, room_type)
              %td #{room_type.capacity}名
              %td= number_to_currency(room_type.base_price)
    - else
      %p.text-muted.mt-2 部屋タイプが登録されていません