= simple_form_for [:admins, :accommodation, room_type] do |f|
  = f.input :name, required: true
  = f.input :capacity, required: true
  = f.input :base_price, required: true
  = f.input :image, as: :file
  = f.input :description, required: true, input_html: { row: 5 }
  = f.input :position
  = f.button :submit, class: 'btn btn-outline-primary'