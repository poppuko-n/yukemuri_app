.container.mt-4
  .fs-2 部屋タイプ詳細

  .row
    .col-md-6
      .card
        .card-body
          %dl
            %dt= RoomType.human_attribute_name(:name)
            %dd= @room_type.name
            %dt= RoomType.human_attribute_name(:capacity)
            %dd= @room_type.capacity
            %dt= RoomType.human_attribute_name(:base_price)
            %dd= @room_type.base_price
            %dt= RoomType.human_attribute_name(:description)
            %dd= @room_type.description
          -# = published_badge(@accommodation)

      = link_to '編集', admins_root_path, class: 'btn btn-outline-success w-100 mt-2'
      = button_to '削除', admins_root_path, method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-outline-danger w-100 mt-2'

    .d-flex.justify-content-between.align-items-center.mt-4
      .fs-2 部屋在庫一覧
      = link_to '部屋在庫作成', admins_root_path, class: 'btn btn btn-outline-primary'

    %p.text-muted.mt-2 部屋在庫が登録されていません