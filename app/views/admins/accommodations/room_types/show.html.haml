.container.mt-4
  .fs-2 部屋タイプ詳細

  .row
    .col-md-6
      .ratio.ratio-4x3
        = image_tag @room_type.image

    .col-md-6
      .card
        .card-body
          %dl
            %dt= RoomType.human_attribute_name(:name)
            %dd= @room_type.name
            %dt= RoomType.human_attribute_name(:capacity)
            %dd= @room_type.capacity
            %dt= RoomType.human_attribute_name(:base_price)
            %dd= number_to_currency(@room_type.base_price)
            %dt= RoomType.human_attribute_name(:description)
            %dd= @room_type.description

      = link_to '編集', edit_admins_accommodation_room_type_path(@accommodation, @room_type), class: 'btn btn-outline-success w-100 mt-2'
      = button_to '削除', admins_accommodation_room_type_path(@accommodation, @room_type), method: :delete, data: { turbo_confirm: '本当に削除しますか？' }, class: 'btn btn-outline-danger w-100 mt-2'

    .d-flex.justify-content-between.align-items-center.mt-4
      .fs-2 部屋在庫一覧
      = link_to '部屋在庫作成', new_admins_accommodation_room_type_room_inventory_path(@accommodation, @room_type), class: 'btn btn btn-outline-primary'

    - if @room_type.room_inventories.any?
      %table.table.table-striped.table-hover.align-middle
        %thread
          %tr
            %th= RoomInventory.human_attribute_name(:date)
            %th= RoomInventory.human_attribute_name(:remaining_room)
            %th
        %tbody
          - @room_type.room_inventories.default_order.each do |room_inventory|
            %tr
              %td= l(room_inventory.date)
              %td #{room_inventory.remaining_room}室
              %td= link_to '編集', edit_admins_accommodation_room_type_room_inventory_path(@accommodation, @room_type, room_inventory), class: 'btn btn-outline-success'

    - else
      %p.text-muted.mt-2 部屋在庫が登録されていません