.container.mt-4
  .d-flex.justify-content-between.align-items-center
    .fs-2 宿泊施設一覧
    = link_to '宿泊施設登録', new_admins_accommodation_path, class: 'btn btn-outline-danger'

  .row.g-4.mt-2
    - @accommodations.each do |accommodation|
      .col-12.col-sm-6.col-md-4.col-lg-3
        .card
          .ratio.ratio-4x3
            = image_tag accommodation.image
          .card-body
            .fs-4= accommodation.name
            .d-flex.justify-content-between.align-items-center
              .fs-6= accommodation.category
              .fs-6= accommodation.prefecture_name
            = link_to '詳細', admins_accommodation_path(accommodation), class: 'btn btn-outline-primary btn-sm w-100 mt-2'
